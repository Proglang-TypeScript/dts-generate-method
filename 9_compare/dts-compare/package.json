{
  "name": "dts-compare",
  "version": "1.3.1",
  "description": "Compares and parses typescript declaration files",
  "bin": {
    "dts-count": "dist/parseToCount.js",
    "dts-compare": "dist/index.js",
    "dts-parse": "dist/parse.js"
  },
  "scripts": {
    "compare": "npm run build && node dist/index.js",
    "parse": "npm run build && node dist/parse.js",
    "count": "npm run build && node dist/parseSimple.js",
    "prebuild": "rm -rf dist",
    "build": "node node_modules/typescript/lib/tsc.js",
    "test": "npm run test:clear-cache && jest",
    "test:clear-cache": "jest --clearCache",
    "lint": "eslint --max-warnings 0 'src/**/*.ts'",
    "prettier": "prettier --write 'src/**/*.ts'"
  },
  "author": "f-cristiani",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git://github.com/proglang/dts-generate-method.git"
  },
  "dependencies": {
    "command-line-args": "6.0.2",
    "eslint-config-prettier": "10.1.8",
    "object-hash": "3.0.0",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@types/command-line-args": "5.2.3",
    "@types/jest": "30.0.0",
    "@types/node": "26.5.1",
    "@types/object-hash": "3.0.6",
    "@typescript-eslint/eslint-plugin": "8.70.0",
    "@typescript-eslint/parser": "8.70.0",
    "eslint": "10.10.0",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "pretty-quick": "4.2.2",
    "ts-jest": "29.4.12",
    "globals": "17.12.0",
    "@eslint/js": "10.0.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
